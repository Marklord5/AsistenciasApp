                <gradient
                    android:startX="20"
                    android:startY="20"
                    android:endX="88"
                    android:endY="88"
                    android:type="linear">
                    <item android:offset="0" android:color="#35C2FB" />
                    <item android:offset="1" android:color="#5A57FF" />
