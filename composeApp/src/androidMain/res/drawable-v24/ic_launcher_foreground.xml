            android:strokeLineJoin="round"
            android:pathData="M 30,85 C 30,70 40,60 54,60 C 68,60 78,70 78,85 M 54,45 m -15,0 a 15,15 0 1,0 30,0 a 15,15 0 1,0 -30,0 M 75,55 l 8,8 l 15,-15">
